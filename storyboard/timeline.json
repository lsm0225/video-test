 "na": [
  {
   "key": "C04",
   "start": 11.917,
   "dur": 2.47,
   "text": "성문에서, 모든 것이 시작됩니다."
  },
  {
   "key": "C05",
   "start": 17.342,
   "dur": 3.88,
   "text": "안양을 담은 조망, 몰입을 위한 시그니처 공간"
  },
  {
   "key": "C06",
   "start": 23.217,
   "dur": 4.23,
   "text": "교실의 경계를 넘어 꿈을 설계하는 창의적 배움터"
  },
  {
   "key": "C07",
   "start": 28.991,
   "dur": 4.4,
   "text": "함께하는 3년의 여정, 1:1 맞춤형 케어의 완성"
  },
  {
   "key": "C09",
   "start": 38.015,
   "dur": 4.21,
   "text": "검증된 환경, 미래를 선도하는 200억 교육사업 선정"
  },
  {
   "key": "C11",
   "start": 47.521,
   "dur": 2.55,
   "text": "스스로 설계하는 내일, 선택의 기회"
  },
  {
   "key": "C12",
   "start": 52.188,
   "dur": 1.9,
   "text": "배움이 머무는 모든 공간"
  },
  {
   "key": "C15",
   "start": 65.966,
   "dur": 3.42,
   "text": "국가대표급 에너지, 땀방울로 증명하는 투지"
  },
  {
   "key": "C16",
   "start": 70.639,
   "dur": 2.38,
   "text": "생각의 깊이가 실력이 되는 시간"
  },
  {
   "key": "C20",
   "start": 85.84,
   "dur": 4.87,
   "text": "안양·과천 전 지역 30분, 컨디션까지 배려하는 등굣길"
  },
  {
   "key": "C22",
   "start": 95.121,
   "dur": 4.21,
   "text": "정성이 담긴 식사, 가족처럼 따뜻한 성문 공동체"
  },
  {
   "key": "C24",
   "start": 103.844,
   "dur": 3.82,
   "text": "사랑과 섬김의 요람, 인성이 실력이 되는 순간"
  },
  {
   "key": "C26",
   "start": 116.546,
   "dur": 3.85,
   "text": "함께 만든 결실, 합격의 환희로 증명하는 성과"
  },
  {
   "key": "C27",
   "start": 121.419,
   "dur": 4.39,
   "text": "국가가 인정한 공신력, 세계로 뻗어가는 글로벌 성문"
  },
  {
   "key": "C29",
   "start": 129.801,
   "dur": 1.5,
   "text": "정상을 향한 조준"
  },
  {
   "key": "C30",
   "start": 136.315,
   "dur": 1.01,
   "text": "성문에서"
  },
  {
   "key": "C31",
   "start": 140.619,
   "dur": 1.06,
   "text": "정점이 되다."
  }
 ],
